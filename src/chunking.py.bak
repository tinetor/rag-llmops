import re

from llama_index.core import Document
from llama_index.core.node_parser import SentenceSplitter


ARTICLE_RE = re.compile(
    r"(?m)^[ \t]*Article[ \t]+(\d+)[ \t]*\r?$"
)

ANNEX_RE = re.compile(
    r"(?mi)^[ \t]*ANNEX[ \t]+[IVXLCDM]+[ \t]*$"
)


def _build_full_text(raw_docs: list) -> tuple[str, list[dict]]:
    """Join page texts and track each page's global character offsets."""
    parts = []
    page_ranges = []
    offset = 0

    for doc in raw_docs:
        page_text = doc.text or ""

        if parts:
            parts.append("\n")
            offset += 1

        start = offset
        parts.append(page_text)
        offset += len(page_text)

        page_ranges.append({
            "start": start,
            "end": offset,
            "metadata": dict(doc.metadata),
        })

    return "".join(parts), page_ranges


def _article_matches(text: str):
    """Return article heading matches before the annexes."""
    annex_match = ANNEX_RE.search(text)
    if annex_match:
        text = text[:annex_match.start()]

    return text, list(ARTICLE_RE.finditer(text))


def _metadata_for_range(
    start: int,
    end: int,
    page_ranges: list[dict],
    article_matches: list,
) -> dict:
    """Calculate source pages and article for a global text range."""
    overlapping = [
        page for page in page_ranges
        if page["start"] < end and page["end"] > start
    ]

    metadata = (
        dict(overlapping[0]["metadata"])
        if overlapping
        else {}
    )

    if overlapping:
        first_page = overlapping[0]["metadata"].get("page_label")
        last_page = overlapping[-1]["metadata"].get("page_label")

        metadata["page_label"] = first_page
        metadata["page_start"] = first_page
        metadata["page_end"] = last_page

    # Assign the article whose heading precedes the chunk's start.
    preceding = [
        match for match in article_matches
        if match.start() <= start
    ]

    metadata["article"] = (
        int(preceding[-1].group(1))
        if preceding
        else None
    )

    return metadata


def _split_by_sentence(
    raw_docs: list,
    chunk_size: int,
    overlap_ratio: float,
) -> list:
    """Split each original page and enrich chunks with article metadata."""
    full_text, page_ranges = _build_full_text(raw_docs)
    text_for_articles, article_matches = _article_matches(full_text)

    splitter = SentenceSplitter(
        chunk_size=chunk_size,
        chunk_overlap=int(chunk_size * overlap_ratio),
    )

    nodes = []

    for doc, page_range in zip(raw_docs, page_ranges):
        page_nodes = splitter.get_nodes_from_documents([doc])

        for node in page_nodes:
            local_start = (
                node.start_char_idx
                if node.start_char_idx is not None
                else 0
            )
            local_end = (
                node.end_char_idx
                if node.end_char_idx is not None
                else len(node.text)
            )

            global_start = page_range["start"] + local_start
            global_end = page_range["start"] + local_end

            metadata = _metadata_for_range(
                global_start,
                global_end,
                page_ranges,
                article_matches,
            )

            node.metadata.update(metadata)
            node.excluded_embed_metadata_keys = list(node.metadata.keys())
            nodes.append(node)

    return nodes


def _split_by_article(
    raw_docs: list,
    chunk_size: int,
    overlap_ratio: float,
) -> list:
    """Split the preamble and articles, preserving source page metadata."""
    full_text, page_ranges = _build_full_text(raw_docs)
    text_for_articles, article_matches = _article_matches(full_text)

    if not article_matches:
        raise ValueError(
            "No article headings detected. Check ARTICLE_RE."
        )

    segments = []
    first_start = article_matches[0].start()

    if text_for_articles[:first_start].strip():
        segments.append({
            "start": 0,
            "end": first_start,
            "article": None,
        })

    for i, match in enumerate(article_matches):
        start = match.start()
        end = (
            article_matches[i + 1].start()
            if i + 1 < len(article_matches)
            else len(text_for_articles)
        )

        if text_for_articles[start:end].strip():
            segments.append({
                "start": start,
                "end": end,
                "article": int(match.group(1)),
            })

    splitter = SentenceSplitter(
        chunk_size=chunk_size,
        chunk_overlap=int(chunk_size * overlap_ratio),
    )

    nodes = []

    for segment in segments:
        start = segment["start"]
        end = segment["end"]
        original_segment = text_for_articles[start:end]
        segment_text = original_segment.strip()
        leading_whitespace = len(original_segment) - len(
            original_segment.lstrip()
        )
        global_document_start = start + leading_whitespace

        doc = Document(
            text=segment_text,
            metadata={"article": segment["article"]},
        )
        doc.excluded_embed_metadata_keys = list(doc.metadata.keys())

        for node in splitter.get_nodes_from_documents([doc]):
            local_start = (
                node.start_char_idx
                if node.start_char_idx is not None
                else 0
            )
            local_end = (
                node.end_char_idx
                if node.end_char_idx is not None
                else len(node.text)
            )

            global_start = global_document_start + local_start
            global_end = global_document_start + local_end

            metadata = _metadata_for_range(
                global_start,
                global_end,
                page_ranges,
                article_matches,
            )

            node.metadata.update(metadata)
            node.excluded_embed_metadata_keys = list(node.metadata.keys())
            nodes.append(node)

    return nodes


def chunking(
    raw_text: list,
    max_chars: int = 1500,
    overlap_ratio: float = 0.1,
    strategy: str = "sentence",
) -> list:
    """Split Documents using sentence or article-aware chunking."""
    if not 0 <= overlap_ratio < 1:
        raise ValueError("overlap_ratio must be between 0 and 1.")

    if max_chars <= 0:
        raise ValueError("max_chars must be greater than 0.")

    if strategy == "sentence":
        return _split_by_sentence(
            raw_text,
            chunk_size=max_chars,
            overlap_ratio=overlap_ratio,
        )

    if strategy == "article":
        return _split_by_article(
            raw_text,
            chunk_size=max_chars,
            overlap_ratio=overlap_ratio,
        )

    raise ValueError(
        "Use 'sentence' or 'article'."
    )


if __name__ == "__main__":
    from config import load_config
    from load_pdf import load_pdf

    config = load_config()
    docs = load_pdf(config["data"]["pdf_path"])

    for strategy in ("sentence", "article"):
        chunks = chunking(
            docs,
            max_chars=config["chunking"]["max_chars"],
            overlap_ratio=config["chunking"]["overlap_ratio"],
            strategy=strategy,
        )

        print(f"\nStrategy: {strategy}")
        print(f"Chunks generated: {len(chunks)}")

        for i, chunk in enumerate(chunks[:5]):
            print(
                f"[{i}] article={chunk.metadata.get('article')} | "
                f"page={chunk.metadata.get('page_label')} | "
                f"range={chunk.metadata.get('page_start')}-"
                f"{chunk.metadata.get('page_end')} | "
            )
